{
  "name": "@app-zum-doc/utils",
  "version": "0.0.1",
  "private": true,
  "description": "Shared utilities and translations for App zum Doc",
  "type": "module",
  "files": [
    "src",
    "locales"
  ],
  "exports": {
    "./i18n": {
      "types": "./src/i18n/index.ts",
      "default": "./src/i18n/index.ts"
    },
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "default": "./src/hooks/index.ts"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "default": "./src/api/index.ts"
    },
    "./theme": {
      "types": "./src/theme/index.ts",
      "default": "./src/theme/index.ts"
    }
  },
  "scripts": {
    "clean": "rm -rf node_modules",
    "barrel": "barrel",
    "build-intl": "build-intl --force -i ./locales -o ./src/i18n/translations.ts -n appZumDocTranslation",
    "init": "pnpm run build-intl && pnpm run barrel",
    "build": "node -e \"process.exit(0)\"",
    "lint": "node -e \"process.exit(0)\"",
    "test": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@helpwave/hightide-design": "0.6.0",
    "@helpwave/hightide-utils": "0.1.0",
    "@helpwave/internationalization": "0.4.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@helpwave/eslint-config": "0.0.11",
    "@tanstack/react-query": "^5.101.3",
    "@types/react": "~19.1.0",
    "eslint": "9.25.0",
    "react": "19.1.0",
    "typescript": "~5.9.2"
  }
}
