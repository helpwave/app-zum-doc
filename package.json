{
  "name": "app-zum-doc-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "App zum Doc monorepo",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "init": "pnpm install && pnpm -r run init",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "reset": "pnpm run clean && pnpm run init",
    "start": "pnpm --filter \"@app-zum-doc/mobile\" start",
    "android": "pnpm --filter \"@app-zum-doc/mobile\" android",
    "ios": "pnpm --filter \"@app-zum-doc/mobile\" ios",
    "administration": "pnpm --filter \"@app-zum-doc/administration\" start",
    "administration:dev": "pnpm --filter \"@app-zum-doc/administration\" dev",
    "build:administration": "pnpm --filter @app-zum-doc/utils run init && pnpm --filter @app-zum-doc/administration run init && pnpm --filter @app-zum-doc/administration run build",
    "build:mobile": "pnpm --filter @app-zum-doc/utils run init && pnpm --filter @app-zum-doc/mobile run build"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.13.0",
      "onFail": "ignore"
    }
  },
  "dependencies": {
    "expo": "~54.0.37",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
