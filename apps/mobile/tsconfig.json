{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "preserveSymlinks": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../packages/app-zum-doc-utils/src/**/*.d.ts"
  ],
  "exclude": ["node_modules"]
}
