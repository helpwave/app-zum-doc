{
  "expo": {
    "name": "App zum Doc",
    "slug": "app-zum-doc",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/azd-logo.png",
    "scheme": "appzumdoc",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.helpwave.appzumdoc",
      "buildNumber": "1"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/azd-logo-foreground.png",
        "monochromeImage": "./assets/images/azd-monochrom-logo-foreground.png"
      },
      "backgroundColor": "#057986",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "de.helpwave.appzumdoc"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/azd-logo.png",
      "splash": {
        "image": "./assets/images/azd-logo-foreground.png",
        "resizeMode": "contain",
        "backgroundColor": "#057986"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/azd-monochrom-logo-foreground.png",
          "color": "#057986"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/azd-logo-foreground.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#057986"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Inter_28pt-Regular.ttf",
            "./assets/fonts/SpaceGrotesk-Light.ttf",
            "./assets/fonts/SpaceGrotesk-Regular.ttf",
            "./assets/fonts/SpaceGrotesk-Medium.ttf",
            "./assets/fonts/SpaceGrotesk-Bold.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Inter_28pt-Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "SpaceGrotesk",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/SpaceGrotesk-Light.ttf",
                    "weight": 300
                  },
                  {
                    "path": "./assets/fonts/SpaceGrotesk-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/SpaceGrotesk-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/SpaceGrotesk-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Inter_28pt-Regular.ttf",
              "./assets/fonts/SpaceGrotesk-Light.ttf",
              "./assets/fonts/SpaceGrotesk-Regular.ttf",
              "./assets/fonts/SpaceGrotesk-Medium.ttf",
              "./assets/fonts/SpaceGrotesk-Bold.ttf"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}