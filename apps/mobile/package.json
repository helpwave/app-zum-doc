{
  "name": "@app-zum-doc/mobile",
  "main": "expo-router/entry",
  "version": "0.0.10",
  "description": "App zum Doc mobile client",
  "license": "AGPL-3.0-only",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helpwave/app-zum-doc.git"
  },
  "scripts": {
    "clean": "rm -rf node_modules && rm -rf ios && rm --rf android",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "init": "npx expo prebuild",
    "prebuild:android": "CI=1 expo prebuild --platform android",
    "prebuild:ios": "CI=1 expo prebuild --platform ios",
    "android:release": "cd android && ./gradlew assembleRelease bundleRelease",
    "build": "CI=1 expo export --platform web",
    "test": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@app-zum-doc/utils": "workspace:*",
    "@expo/vector-icons": "^15.0.3",
    "@helpwave/hightide-design": "0.7.6",
    "@helpwave/hightide-native": "0.10.1",
    "@helpwave/hightide-utils": "0.1.7",
    "@helpwave/internationalization": "0.4.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.101.3",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^0.561.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-quick-crypto": "^1.1.7",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  }
}