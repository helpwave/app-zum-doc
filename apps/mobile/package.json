{
  "name": "@app-zum-doc/mobile",
  "main": "expo-router/entry",
  "version": "0.0.15",
  "description": "App zum Doc mobile client",
  "license": "AGPL-3.0-only",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helpwave/app-zum-doc.git"
  },
  "scripts": {
    "clean": "rm -rf node_modules && rm -rf ios && rm --rf android",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "init": "npx expo prebuild",
    "prebuild:android": "CI=1 expo prebuild --platform android",
    "prebuild:ios": "CI=1 expo prebuild --platform ios",
    "android:release": "cd android && ./gradlew assembleRelease bundleRelease",
    "build": "CI=1 expo export --platform web",
    "test": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@app-zum-doc/utils": "workspace:*",
    "@expo/vector-icons": "^15.0.2",
    "@helpwave/hightide-design": "0.7.6",
    "@helpwave/hightide-native": "0.10.3",
    "@helpwave/hightide-utils": "0.1.9",
    "@helpwave/internationalization": "0.4.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.101.3",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "lucide-react-native": "^0.561.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "9.25.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~5.9.2"
  }
}
